doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible", content="IE=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="https://unpkg.com/mvp.css")
    link(rel="stylesheet", href="/zoom/css/styles.css?v=2")
    title Yaqin
  body
    header
      h1 Yaqin
      h3#roomLabel.hidden
    main
      // 👇 visible only before joining
      div#welcome
        form
          input(placeholder="room name", required, type="text")
          button Enter Room
      // 👇 hidden until user joins a room
      div#call.hidden
        div.video-container
          div#myStream
            div.video-box
              video#myFace(autoplay, playsinline, muted)
          
          div#peerStream
            div.video-box
              video#peerFace(autoplay, playsinline)
        
        div.controls
          button#mute Mute
          button#camera Turn Camera Off
          select#cameras
          button#leave Leave Room
    script(src="/zoom/socket.io/socket.io.js")
    script(src="/zoom/js/app.js")
